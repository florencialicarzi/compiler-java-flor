package lyc.compiler;

import java_cup.runtime.*;

// ============================================================
// Parser class
// ============================================================
class Parser;

// ============================================================
// Terminals
// ============================================================
terminal PUBLIC, STATIC, CLASS, VOID, INT, FOR, MAIN, STRING;
terminal ASSIG, PLUS, SUB, MULT, DIV;
terminal LE, GE, LT, GT, EQ, NE, INC;
terminal SEMICOLON, OPEN_CURLY, CLOSE_CURLY, OPEN_BRACKET, CLOSE_BRACKET;
terminal INTEGER_CONSTANT, IDENTIFIER;
terminal OPEN_SQUARE, CLOSE_SQUARE;

// ============================================================
// Non Terminals
// ============================================================
non terminal program;
non terminal decl;
non terminal decls;
non terminal stmts;
non terminal stmt;
non terminal for_stmt;
non terminal block;
non terminal class_block;
non terminal method_decl;

non terminal assignment;
non terminal expression;
non terminal term;
non terminal factor;
non terminal condition;
non terminal incr;
non terminal var_decl;

// ============================================================
// Precedence and Associativity
// ============================================================
precedence left PLUS, SUB;
precedence left MULT, DIV;
precedence left LT, LE, GT, GE, EQ, NE;

// ============================================================
// Start Symbol
// ============================================================
start with program;

// ============================================================
// Grammar Rules
// ============================================================

// --- Nivel programa ---
program ::= decls ;

// --- Declaraciones ---
decl ::= PUBLIC CLASS IDENTIFIER class_block
         {: System.out.println("Public class declaration"); :}
       | CLASS IDENTIFIER class_block
         {: System.out.println("Class declaration"); :}
       | method_decl
       | var_decl
       ;

// Declaración de método main
method_decl ::= PUBLIC STATIC VOID MAIN OPEN_BRACKET STRING OPEN_SQUARE CLOSE_SQUARE IDENTIFIER CLOSE_BRACKET block
                {: System.out.println("Main method declaration"); :}
              | PUBLIC STATIC VOID IDENTIFIER OPEN_BRACKET CLOSE_BRACKET block
                {: System.out.println("Void method declaration"); :}
              ;

// Declaración de variables
var_decl ::= INT IDENTIFIER SEMICOLON
             {: System.out.println("Variable declaration"); :}
           | INT IDENTIFIER ASSIG expression SEMICOLON
             {: System.out.println("Variable declaration with initialization"); :}
           ;

// Secuencia de declaraciones
decls ::= decls decl
        | decl
        ;

// --- Bloque de clase ---
class_block ::= OPEN_CURLY decls CLOSE_CURLY
              | OPEN_CURLY CLOSE_CURLY
              ;

// --- Secuencia de sentencias ---
stmts ::= stmts stmt
        | stmt
        ;

// --- Una sentencia ---
stmt ::= assignment SEMICOLON 
         {: System.out.println("Assignment statement"); :}
       | for_stmt
       | block
       | var_decl
       ;

// --- Estructura for ---
for_stmt ::= FOR OPEN_BRACKET var_decl condition SEMICOLON incr CLOSE_BRACKET stmt
             {: System.out.println("For loop with variable declaration"); :}
           | FOR OPEN_BRACKET assignment SEMICOLON condition SEMICOLON incr CLOSE_BRACKET stmt
             {: System.out.println("For loop with assignment"); :}
           ;

// --- Bloques de código ---
block ::= OPEN_CURLY stmts CLOSE_CURLY
        | OPEN_CURLY CLOSE_CURLY
        ;

// ============================================================
// Reglas de expresiones y asignaciones
// ============================================================

assignment ::= IDENTIFIER ASSIG expression
               {: System.out.println("Assignment"); :};

// Expresiones con operadores aritméticos y comparativos
expression ::= expression PLUS term 
               {: System.out.println("Addition"); :}
             | expression SUB term  
               {: System.out.println("Subtraction"); :}
             | expression LT term   
               {: System.out.println("Less than"); :}
             | expression LE term   
               {: System.out.println("Less than or equal"); :}
             | expression GT term   
               {: System.out.println("Greater than"); :}
             | expression GE term   
               {: System.out.println("Greater than or equal"); :}
             | expression EQ term   
               {: System.out.println("Equal"); :}
             | expression NE term   
               {: System.out.println("Not equal"); :}
             | term                 
               {: System.out.println("Expression = Term"); :}
             ;

term ::= term MULT factor 
         {: System.out.println("Multiplication"); :}
       | term DIV factor  
         {: System.out.println("Division"); :}
       | factor           
         {: System.out.println("Term = factor"); :}
       ;

factor ::= IDENTIFIER:id
           {: System.out.println("Id: " + id); :}
         | INTEGER_CONSTANT:constant
           {: System.out.println("Constant: " + constant ); :}
         | OPEN_BRACKET expression CLOSE_BRACKET
           {: System.out.println("Factor = (Expression)"); :}
         ;

// ============================================================
// Incremento (i++ o ++i)
// ============================================================
incr ::= IDENTIFIER INC
         {: System.out.println("Post-increment"); :}
       | INC IDENTIFIER
         {: System.out.println("Pre-increment"); :}
       ;

// ============================================================
// Condición booleana (comparaciones)
// ============================================================
condition ::= expression
              {: System.out.println("Condition"); :};